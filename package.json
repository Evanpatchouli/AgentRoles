{
  "name": "agentroles",
  "version": "0.1.1",
  "releaseDate": "2026-11-13",
  "description": "为每个角色配备独立智能体：模型、角色设定与技能都可配置的桌面工作台",
  "main": "./out/main/index.js",
  "author": "AgentRoles",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "test:e2e": "electron-vite build && node scripts/e2e.mjs",
    "test:integrations": "node scripts/test-integrations.mjs",
    "test:notion": "tsx scripts/test-notion.ts",
    "test:all": "npm run docs:check && npm run typecheck && npm run test:memory && npm run test:memory-index && npm run test:embedding && npm run test:notion && npm run test:models && npm run test:integrations && npm run test:update && npm run test:migration && npm run test:e2e",
    "test:models": "tsx scripts/test-models.ts",
    "test:migration": "electron-vite build && node scripts/test-migration.mjs",
    "test:memory": "tsx scripts/test-memory.ts",
    "test:memory-index": "tsx scripts/test-memory-index.ts",
    "test:embedding": "tsx scripts/test-embedding.ts",
    "test:update": "tsx scripts/test-update.ts",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.65.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
